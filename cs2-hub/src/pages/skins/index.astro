---
import Layout from '../../layouts/Layout.astro';
import { WEAPON_CATEGORIES, RARITY_MAP, type WeaponCategory } from '../../data/skins';
import { getSkinsPage, getSkinCounts } from '../../lib/skins';

const PAGE_SIZE = 30;

const [firstPage, counts] = await Promise.all([
  getSkinsPage({}, 0, PAGE_SIZE - 1),
  getSkinCounts(),
]);

const categories = Object.keys(counts.byCategory) as WeaponCategory[];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Baza skinów CS2",
  "description": "Opisy, statystyki i ceny wszystkich skinów CS2. Float range, rarity, historia wartości.",
  "url": "https://cs2-market.netlify.app/skins",
  "inLanguage": "pl",
};
---

<Layout
  title="Baza skinów CS2 – opisy, ceny, float range"
  description="Kompletna baza skinów CS2. Opisy, float range, rarity i linki do Steam Market. AK-47, AWP, M4A4, M4A1-S, noże, rękawice i więcej."
  schema={schema}
>
<div class="container">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Strona główna</a><span>›</span>
    <span>Baza skinów</span>
  </nav>

  <div class="page-header">
    <h1>Baza skinów CS2</h1>
    <p>Opisy, statystyki float range, rzadkości i linki do Steam Market. {counts.total} skinów w bazie.</p>
  </div>

  <!-- Search -->
  <div class="skins-search-wrap">
    <input type="text" id="skinsSearch" class="skins-search-input" placeholder="Szukaj skina, np. AK-47, Redline, AWP..." autocomplete="off" />
    <span id="skinsSearchCount" class="skins-search-count"></span>
  </div>

  <!-- Filter bar -->
  <div class="filter-bar">
    <button class="filter-btn active" data-filter="all">Wszystkie ({counts.total})</button>
    {categories.map(cat => (
      <button class="filter-btn" data-filter={cat}>
        {WEAPON_CATEGORIES[cat]} ({counts.byCategory[cat]})
      </button>
    ))}
  </div>

  <!-- Skins grid: pierwsza strona renderowana od razu (SSG), reszta doładowywana przy scrollu -->
  <div class="skins-grid" id="skinsGrid">
    {firstPage.map(skin => (
      <a href={`/skins/${skin.slug}`} class="skin-card">
        <div class="skin-card-header" style={`border-top-color: ${RARITY_MAP[skin.rarity]?.color || '#4b69ff'}`}>
          <div class="skin-weapon-tag">{skin.weapon}</div>
          <span class="skin-rarity-badge" style={`color: ${RARITY_MAP[skin.rarity]?.color || '#4b69ff'}`}>
            {RARITY_MAP[skin.rarity]?.label}
          </span>
        </div>
        {skin.imageUrl && (
          <div class="skin-card-image">
            <img src={skin.imageUrl} alt={`${skin.weapon} | ${skin.name}`} loading="lazy" width="256" height="192" />
          </div>
        )}
        <div class="skin-card-body">
          <h2 class="skin-name">{skin.weapon} | {skin.name}</h2>
          <p class="skin-desc">{skin.description.slice(0, 100)}...</p>
        </div>
        <div class="skin-card-footer">
          <div class="skin-float-range">
            <span class="skin-meta-label">Float</span>
            <span class="skin-meta-val">{skin.minFloat.toFixed(2)} – {skin.maxFloat.toFixed(2)}</span>
          </div>
          <div class="skin-wears-mini">
            {skin.wears.map(w => (
              <span class="wear-dot" title={w}></span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>

  <div id="skinsSentinel" class="skins-sentinel" aria-hidden="true"></div>
  <p id="skinsLoadingState" class="skins-loading-state" style="display:none">Wczytuję kolejne skiny…</p>
  <p id="skinsEmptyState" class="skins-empty-state" style="display:none">Brak skinów pasujących do wyszukiwania.</p>

  <!-- SEO content -->
  <section class="seo-content">
    <h2>Jak wybrać skin do CS2?</h2>
    <p>
      Przy wyborze skina do CS2 warto zwrócić uwagę na kilka kluczowych parametrów.
      <strong>Float value</strong> (wartość od 0.00 do 1.00) określa stopień zużycia skina —
      im niższa wartość, tym lepszy wygląd. Factory New (0.00–0.07) jest najlepszą jakością,
      Battle-Scarred (0.45–1.00) — najgorszą.
    </p>
    <p>
      <strong>Rarity</strong> (rzadkość) wpływa na cenę i dostępność. Skiny Covert (czerwone)
      i Classified (różowe) są rzadkie i zwykle drogie. Mil-Spec (niebieskie) to najpowszechniejsza
      rzadkość ze skrzynek.
    </p>
    <p>
      <strong>Wear range</strong> to zakres floatu dostępny dla danego skina — nie każdy skin
      można kupić w Factory New. Na przykład AK-47 Redline ma minimalny float 0.10,
      więc Factory New nie istnieje.
    </p>
  </section>

</div>
</Layout>

<script>
import { supabaseBrowser } from '../../lib/supabaseBrowser';
import { RARITY_MAP } from '../../data/skins';

const PAGE_SIZE = 30; // musi być zgodne z PAGE_SIZE w frontmatterze (pierwsza strona renderowana server-side)

const grid = document.getElementById('skinsGrid') as HTMLElement;
const sentinel = document.getElementById('skinsSentinel') as HTMLElement;
const loadingState = document.getElementById('skinsLoadingState') as HTMLElement;
const emptyState = document.getElementById('skinsEmptyState') as HTMLElement;
const btns = document.querySelectorAll('.filter-btn');
const searchInput = document.getElementById('skinsSearch') as HTMLInputElement;
const searchCount = document.getElementById('skinsSearchCount') as HTMLElement;

let activeCategory: string = 'all';
let activeSearch = '';
let offset = PAGE_SIZE; // pierwsza strona już wyrenderowana server-side
let loading = false;
let hasMore = true;
let requestId = 0; // żeby ignorować odpowiedzi ze "starych" zapytań po zmianie filtra

function escapeHtml(s: string) {
  return s.replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] as string));
}

function renderCard(skin: any): string {
  const color = RARITY_MAP[skin.rarity]?.color || '#4b69ff';
  const label = RARITY_MAP[skin.rarity]?.label || skin.rarity;
  const img = skin.image_url
    ? `<div class="skin-card-image"><img src="${skin.image_url}" alt="${escapeHtml(skin.weapon)} | ${escapeHtml(skin.name)}" loading="lazy" width="256" height="192" /></div>`
    : '';
  const wears = (skin.wears || []).map((w: string) => `<span class="wear-dot" title="${escapeHtml(w)}"></span>`).join('');
  return `
    <a href="/skins/${skin.slug}" class="skin-card">
      <div class="skin-card-header" style="border-top-color: ${color}">
        <div class="skin-weapon-tag">${escapeHtml(skin.weapon)}</div>
        <span class="skin-rarity-badge" style="color: ${color}">${escapeHtml(label)}</span>
      </div>
      ${img}
      <div class="skin-card-body">
        <h2 class="skin-name">${escapeHtml(skin.weapon)} | ${escapeHtml(skin.name)}</h2>
        <p class="skin-desc">${escapeHtml((skin.description || '').slice(0, 100))}...</p>
      </div>
      <div class="skin-card-footer">
        <div class="skin-float-range">
          <span class="skin-meta-label">Float</span>
          <span class="skin-meta-val">${Number(skin.min_float).toFixed(2)} – ${Number(skin.max_float).toFixed(2)}</span>
        </div>
        <div class="skin-wears-mini">${wears}</div>
      </div>
    </a>
  `;
}

async function loadMore() {
  if (loading || !hasMore) return;
  loading = true;
  loadingState.style.display = 'block';
  const myRequestId = requestId;

  let query = supabaseBrowser
    .from('skins')
    .select('*')
    .order('weapon', { ascending: true })
    .order('name', { ascending: true })
    .range(offset, offset + PAGE_SIZE - 1);

  if (activeCategory !== 'all') query = query.eq('category', activeCategory);
  if (activeSearch) query = query.or(`weapon.ilike.%${activeSearch}%,name.ilike.%${activeSearch}%`);

  const { data, error } = await query;

  if (myRequestId !== requestId) return; // filtr/search zmienił się w międzyczasie — ignoruj

  loading = false;
  loadingState.style.display = 'none';

  if (error) {
    console.error('Błąd wczytywania skinów:', error);
    hasMore = false;
    return;
  }

  const rows = data || [];
  grid.insertAdjacentHTML('beforeend', rows.map(renderCard).join(''));
  offset += rows.length;
  hasMore = rows.length === PAGE_SIZE;

  const totalShown = grid.querySelectorAll('.skin-card').length;
  if (activeSearch || activeCategory !== 'all') {
    searchCount.textContent = `Wczytano: ${totalShown}`;
  }
  emptyState.style.display = totalShown === 0 && !hasMore ? 'block' : 'none';
}

function resetAndReload() {
  requestId++;
  grid.innerHTML = '';
  offset = 0;
  hasMore = true;
  emptyState.style.display = 'none';
  loadMore();
}

const observer = new IntersectionObserver(entries => {
  if (entries[0].isIntersecting) loadMore();
}, { rootMargin: '600px' });
observer.observe(sentinel);

btns.forEach(btn => {
  btn.addEventListener('click', () => {
    btns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeCategory = (btn as HTMLElement).dataset.filter || 'all';
    resetAndReload();
  });
});

let searchDebounce: ReturnType<typeof setTimeout>;
searchInput.addEventListener('input', () => {
  clearTimeout(searchDebounce);
  searchDebounce = setTimeout(() => {
    activeSearch = searchInput.value.trim();
    resetAndReload();
  }, 300);
});
</script>

<style is:global>
.breadcrumb { display:flex; align-items:center; gap:8px; padding:20px 0 0; font-size:13px; color:var(--text2); }
.breadcrumb a { color:var(--text2); text-decoration:none; }
.breadcrumb a:hover { color:var(--accent); }

.page-header { padding:32px 0 40px; border-bottom:1px solid var(--border); margin-bottom:36px; }
.page-header h1 { font-size:clamp(26px,4vw,44px); font-weight:900; margin-bottom:12px; }
.page-header p { font-size:16px; color:var(--text2); max-width:700px; line-height:1.7; }

.skins-search-wrap { position: relative; margin-bottom: 20px; }
.skins-search-input {
  width: 100%;
  background: var(--bg2); border: 1px solid var(--border); border-radius: 10px;
  padding: 12px 16px; color: var(--text); font-family: var(--font); font-size: 15px;
}
.skins-search-input:focus { outline: none; border-color: var(--border2); }
.skins-search-count { display: block; margin-top: 8px; font-size: 12px; color: var(--text2); font-family: var(--font-mono); }
.skins-empty-state { text-align: center; padding: 48px 0; color: var(--text2); font-size: 15px; }
.skins-loading-state { text-align: center; padding: 20px 0; color: var(--text2); font-size: 13px; font-family: var(--font-mono); }
.skins-sentinel { height: 1px; }

.filter-bar { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:32px; }
.filter-btn {
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:20px;
  padding:6px 16px;
  font-family:var(--font);
  font-size:13px;
  font-weight:600;
  color:var(--text2);
  cursor:pointer;
  transition:all 0.2s;
  letter-spacing:0.3px;
}
.filter-btn:hover, .filter-btn.active {
  background:rgba(0,212,255,0.1);
  border-color:var(--border2);
  color:var(--accent);
}

.skins-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(240px,1fr));
  gap:16px;
  margin-bottom:24px;
}
.skin-card {
  display:flex;
  flex-direction:column;
  background:var(--bg2);
  border:1px solid var(--border);
  border-radius:var(--radius);
  overflow:hidden;
  text-decoration:none;
  transition:all 0.2s;
}
.skin-card:hover { border-color:var(--border2); background:var(--bg3); transform:translateY(-2px); text-decoration:none; }

.skin-card-header {
  border-top:3px solid;
  padding:14px 16px 10px;
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
}
.skin-card-image {
  display:flex;
  align-items:center;
  justify-content:center;
  padding:6px 16px;
  background:var(--bg3);
}
.skin-card-image img { width:100%; max-height:120px; object-fit:contain; }
.skin-weapon-tag {
  font-family:var(--font-mono);
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:1.5px;
  color:var(--text2);
}
.skin-rarity-badge {
  font-family:var(--font-mono);
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:0.5px;
  font-weight:600;
}
.skin-card-body { padding:0 16px 14px; flex:1; }
.skin-name { font-size:15px; font-weight:700; color:#e8f4f8; margin-bottom:8px; line-height:1.3; }
.skin-desc { font-size:13px; color:var(--text2); line-height:1.6; }
.skin-card-footer {
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:10px 16px;
  border-top:1px solid var(--border);
  background:var(--bg3);
}
.skin-meta-label { font-size:10px; text-transform:uppercase; letter-spacing:1px; color:var(--text2); display:block; }
.skin-meta-val { font-family:var(--font-mono); font-size:12px; color:#e8f4f8; }
.skin-wears-mini { display:flex; gap:4px; }
.wear-dot {
  width:8px; height:8px;
  border-radius:50%;
  background:var(--accent);
  opacity:0.6;
}

.seo-content { border-top:1px solid var(--border); padding-top:48px; margin-bottom:60px; }
.seo-content h2 { font-size:22px; margin-bottom:16px; }
.seo-content p { font-size:15px; color:var(--text2); line-height:1.8; margin-bottom:14px; }
.seo-content strong { color:#e8f4f8; }
</style>
