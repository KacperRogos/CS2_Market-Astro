---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Strona nie znaleziona (404)"
  description="Ta strona nie istnieje albo została przeniesiona. Wróć na stronę główną CS2 Trading Hub."
  noindex={true}
>
<div class="container">
  <div class="error-page">
    <div class="error-code">404</div>
    <h1>Ups, ta strona nie istnieje</h1>
    <p>Skrzynka, skin albo strona, której szukasz, mogła zostać usunięta, przeniesiona albo nigdy nie istniała pod tym adresem.</p>

    <div class="error-actions">
      <a href="/" class="btn btn-primary">Wróć na stronę główną</a>
      <a href="/skins" class="btn btn-ghost">Baza skinów</a>
      <a href="/kalkulator" class="btn btn-ghost">Kalkulator skrzynek</a>
    </div>

    <div class="error-links">
      <a href="/porownaj">Porównywarka cen</a>
      <a href="/poradniki">Poradniki</a>
      <a href="/app">Mój portfel</a>
    </div>
  </div>
</div>
</Layout>

<style>
.error-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 100px 20px 120px;
  max-width: 560px;
  margin: 0 auto;
}
.error-code {
  font-family: var(--font-hud);
  font-size: clamp(64px, 14vw, 120px);
  font-weight: 900;
  color: var(--accent);
  line-height: 1;
  text-shadow: 0 0 40px rgba(0,212,255,0.35);
}
.error-page h1 {
  font-size: clamp(22px, 4vw, 32px);
  font-weight: 800;
  margin: 16px 0 12px;
}
.error-page p {
  color: var(--text2);
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 32px;
}
.error-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-bottom: 28px;
}
.error-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px 20px;
}
.error-links a {
  font-size: 13px;
  color: var(--text2);
  text-decoration: none;
}
.error-links a:hover {
  color: var(--accent);
}
</style>
